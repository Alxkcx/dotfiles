#!/usr/bin/env bash
set -e

COMFY="$HOME/AI_Workspace/ComfyUI-Desktop/ComfyUI-Installs/Comfyui_/ComfyUI"

cd "$COMFY/custom_nodes"

find . \
    -path "./.disabled" -prune -o \
    -mindepth 1 -maxdepth 1 -type d -print0 |
while IFS= read -r -d '' dir
do
    if [[ -f "$dir/requirements.txt" ]]; then
        echo
        echo "======================================="
        echo "${dir#./}"
        echo "======================================="

        uv pip install --python "$COMFY/.venv/bin/python" -r "$dir/requirements.txt"
    fi
done
