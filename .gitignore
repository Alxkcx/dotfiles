# 备份文件
*.bak
*.backup*
*备份*

# 自动生成的大文件 (>100KB)
**/dank-colors.css

# Fish 自动生成的状态
config/fish/fish_variables

# Yazi flavor 预览图片（仅用于主题选择器展示）
config/yazi/flavors/*/preview.png

# Rime 构建缓存和字典（由 rime-ice 管理）
config/fcitx5/rime/build/

# Fcitx5 缓存
config/fcitx5/conf/cached_layouts

# 编辑器临时文件
*~
.*.swp
.*.swo
.DS_Store

# Python 缓存
__pycache__/
*.py[cod]
