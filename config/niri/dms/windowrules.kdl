// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_1 @name=
window-rule {
    match app-id="file_chooser"
    open-floating true
}

// @id=dms_rule_2 @name=
window-rule {
    match app-id="^clawd-on-desk$" title="^Clawd$"
    open-floating true
    geometry-corner-radius 0
    draw-border-with-background false
    background-effect {
        blur false
        xray false
    }
    default-floating-position x=0 y=0 relative-to="bottom-right"
}

// @id=dms_rule_3 @name=
window-rule {
    match app-id="^clawd-on-desk$" title="^Clawd Settings$"
    open-floating true
}

